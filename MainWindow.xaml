<Window x:Class="felkaruRablo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:felkaruRablo"
        mc:Ignorable="d"
        Title="MainWindow" Height="1200" Width="600">
    <Grid>

		<Grid.Background>
			<ImageBrush ImageSource="Images/background.jpg"
                        Stretch="UniformToFill"/>
		</Grid.Background>

		<Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

			<Image Source="Images/slotmachine.png"
                   Stretch="Uniform" Margin="18,-16,0,10"/>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="-70,-150,0,0">

				<Border Width="105"
                        Height="170"
                        Background="White"
                        ClipToBounds="True"
                        Margin="8">

					<Image x:Name="Reel1"
                           Stretch="Uniform"/>
				</Border>

				<Border Width="105"
                        Height="170"
                        Background="White"
                        ClipToBounds="True"
                        Margin="8">

					<Image x:Name="Reel2"
                           Stretch="Uniform"/>
				</Border>

				<Border Width="105"
                        Height="170"
                        Background="White"
                        ClipToBounds="True"
                        Margin="8">

					<Image x:Name="Reel3"
                           Stretch="Uniform"/>
				</Border>

			</StackPanel>

		</Grid>

		<StackPanel VerticalAlignment="Bottom"
                    Margin="20">

			<TextBlock x:Name="BalanceText"
                       Text="Balance: 100"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

			<Button Content="SPIN"
                    Width="150"
                    Height="50"
                    FontSize="22"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Click="Spin_Click"/>

			<TextBlock x:Name="ResultText"
                       Text=""
                       FontSize="20"
                       Foreground="Yellow"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

		</StackPanel>

	</Grid>
</Window>
